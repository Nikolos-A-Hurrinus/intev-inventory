<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nikoloshurrinus.interviewproject.InventoryPageController">
   <children>
      <TableView fx:id="InventoryTable" layoutY="68.0" prefHeight="230.0" prefWidth="600.0">
        <columns>
          <TableColumn fx:id="NameColumn" prefWidth="75.0" text="Item" />
          <TableColumn fx:id="CategoryColumn" prefWidth="75.0" text="category" />
            <TableColumn fx:id="QuantityColumn" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="deleteColumn" prefWidth="75.0" text="Delete" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="236.0" layoutY="26.0" text="INVENTORY">
         <font>
            <Font size="24.0" />
         </font>
      </Label>
      <TextField fx:id="NameTextField" layoutX="58.0" layoutY="335.0" promptText="Name" />
      <TextField fx:id="CategoryTextField" layoutX="224.0" layoutY="335.0" promptText="Category" />
      <TextField fx:id="QuantityTextField" layoutX="392.0" layoutY="335.0" promptText="Quantity" />
      <Button fx:id="AddButton" layoutX="195.0" layoutY="373.0" mnemonicParsing="false" onAction="#AddButtonClicked" text="ADD" />
      <Button fx:id="UpdateButton" layoutX="356.0" layoutY="373.0" mnemonicParsing="false" onAction="#UpdateButtonClicked" text="Update" />
   </children>
</AnchorPane>
